# ==================== 代理服务配置 ====================

# 代理服务监听端口（HTTP/SOCKS5 统一入口）
PROXY_PORT=8280

# 代理文件路径
PROXY_FILE=proxy.txt

# 失效代理文件路径
FAILURE_PROXY_FILE=failure-proxy.txt

# 总的最大空闲连接数
MAX_IDLE_CONNS=1000

# 每个主机的最大空闲连接数
MAX_IDLE_CONNS_PER_HOST=100

# 单个请求的最大代理重试次数
MAX_RETRY_COUNT=3

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 代理服务器认证（留空则不需要认证，HTTP和SOCKS5共用）
AUTH_USERNAME=
AUTH_PASSWORD=

# ==================== API 服务配置 ====================

# 是否启用 API 服务
API_ENABLED=false

# API 服务监听端口
API_PORT=8281

# API 访问密钥（留空则不需要认证）
API_KEY=

# 代理检查 URL
CHECK_URL=https://www.google.com

# 代理检查失败重试次数
CHECK_RETRY=5
